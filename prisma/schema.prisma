generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Visitor {
  id         String   @id @default(cuid())
  ip         String
  city       String
  region     String?  // Added for state/province level precision
  country    String
  postalCode String?  // Added for ZIP/Postal code
  latitude   Float?   // Added for map coordinates
  longitude  Float?   // Added for map coordinates
  userAgent  String
  path       String
  timestamp  DateTime @default(now())
}